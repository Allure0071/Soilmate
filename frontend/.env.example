# Defaults are in src/map/config.json. These optional settings override them.
# Copy to .env.local, configure locally, then restart Vite / rebuild production.
# VITE_ values are browser-visible. Never put a server secret here.
VITE_MAP_PROVIDER=
VITE_AMAP_KEY=
# Optional server-side security-code proxy, ending in /_AMapService:
VITE_AMAP_SERVICE_HOST=
# For Tianditu: set VITE_MAP_PROVIDER=tianditu and a browser application key.
VITE_TIANDITU_KEY=
